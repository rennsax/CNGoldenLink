<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.2.3</Version>
    <CelestePath Condition="'$(CelestePath)' == ''">$(MSBuildProjectDirectory)/..</CelestePath>
    <CctAssemblyPath Condition="'$(CctAssemblyPath)' == ''">$(CelestePath)/Mods/Cache/ConsistencyTracker.ConsistencyTracker.dll</CctAssemblyPath>
    <OverlayPreviewDirectory>$(MSBuildProjectDirectory)/overlay-preview</OverlayPreviewDirectory>
    <OverlayPreviewDistDirectory>$(OverlayPreviewDirectory)/dist</OverlayPreviewDistDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="Celeste"><HintPath>$(CelestePath)/Celeste.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MMHOOK_Celeste"><HintPath>$(CelestePath)/MMHOOK_Celeste.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FNA"><HintPath>$(CelestePath)/FNA.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ConsistencyTracker"><HintPath>$(CctAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="BuildOverlayAssets" BeforeTargets="AssignTargetPaths">
    <Exec WorkingDirectory="$(OverlayPreviewDirectory)" Command="yarn build" />
    <ItemGroup>
      <EmbeddedResource Include="$(OverlayPreviewDistDirectory)/index.html" LogicalName="OverlayAsset.index.html" />
      <EmbeddedResource Include="$(OverlayPreviewDistDirectory)/app.mjs" LogicalName="OverlayAsset.app.mjs" />
      <EmbeddedResource Include="$(OverlayPreviewDistDirectory)/style.css" LogicalName="OverlayAsset.style.css" />
    </ItemGroup>
  </Target>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CelestePath)/Celeste.dll')" Text="Set -p:CelestePath to an Everest-patched Celeste installation." />
  </Target>
</Project>
